<% heading = "Where should ‘#{@archival.tag.title_including_parent}’ redirect to?" %>
<% content_for :page_title, heading %>

<%= render "shared/breadcrumbs", {
  links: [
    {
      text: "Mainstream browse pages",
      href: mainstream_browse_pages_url,
    },
    *([
      text: @archival.tag.parent[:title],
      href: mainstream_browse_page_url(@archival.tag.parent),
    ] if @archival.tag.parent.present? ),
    {
      text: @archival.tag[:title],
      href: mainstream_browse_page_url(@archival.tag),
    },
    {
      text: "Archive",
    },
  ],
} %>

<%= render "shared/error_summary", object: @archival %>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <%= form_with url: confirm_archive_mainstream_browse_page_path(@archival.tag), method: :get, scope: nil do %>
      <%
        browse_page_select = render("govuk_publishing_components/components/select_with_search", {
          id: "mainstream_browse_page_archival_form_successor",
          name: "mainstream_browse_page_archival_form[successor]",
          label: "Mainstream browse page",
          full_width: true,
          grouped_options: [
            ["", [{ text: "Select a mainstream browse page", value: "" }]],
            *@archival.grouped_browse_pages,
          ],
          error_items: errors_for(@archival, :successor),
        })

        path_input = render("govuk_publishing_components/components/input", {
          label: {
            text: "Page URL path",
          },
          hint: "Enter the path from the page URL, for example ‘/government/publications/what-hmrc-does-to-prevent-tax-evasion’",
          id: "mainstream_browse_page_archival_form_successor_path",
          name: "mainstream_browse_page_archival_form[successor_path]",
          value: @archival.successor_path,
          error_items: errors_for(@archival, :successor_path),
        })
      %>

      <%= render "govuk_publishing_components/components/radio", {
        name: "mainstream_browse_page_archival_form[redirect_type]",
        id: "mainstream_browse_page_archival_form_redirect_type",
        heading: heading,
        heading_size: "l",
        heading_caption: "Archive mainstream browse page",
        heading_level: 1,
        error_items: errors_for(@archival, :redirect_type),
        items: [
          {
            value: "browse_page",
            text: "Another mainstream browse page",
            checked: @archival.redirecting_to_browse_page?,
            conditional: browse_page_select,
          },
          {
            value: "path",
            text: "A different type of GOV.UK page",
            checked: @archival.redirecting_to_path?,
            conditional: path_input,
          },
        ],
      } %>

      <%= render "govuk_publishing_components/components/button", {
        text: "Continue",
      } %>
    <% end %>
  </div>
</div>
